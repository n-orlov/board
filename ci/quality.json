{
    "coverage": {
        "enabled": true,
        "total_floor": 85,
        "package_floor": 80,
        "fixture_floor": 50
    },
    "crap": {
        "enabled": true,
        "ceiling": 8,
        "fixture_ceiling": 8
    },
    "crap_ts": {
        "enabled": true,
        "ceiling": 8
    },
    "frontend_coverage": {
        "enabled": true,
        "total_floor": 85,
        "file_floor": 80
    },
    "trivy": {
        "enabled": true,
        "severity": "HIGH,CRITICAL"
    },
    "trivy_image": {
        "enabled": true,
        "severity": "HIGH,CRITICAL"
    },
    "govulncheck": {
        "enabled": true
    },
    "golangci": {
        "enabled": true
    },
    "mutation_go": {
        "enabled": true,
        "efficacy": 80,
        "packages": [
            "internal/domain",
            "internal/store",
            "internal/asks",
            "internal/attention",
            "internal/checkin",
            "internal/cursors",
            "internal/events",
            "internal/feed",
            "internal/notes",
            "internal/server",
            "internal/cli"
        ],
        "lanes": {
            "base": ["internal/domain", "internal/store"],
            "logic": [
                "internal/asks",
                "internal/attention",
                "internal/checkin",
                "internal/cursors",
                "internal/events",
                "internal/feed",
                "internal/notes"
            ],
            "server-ops": ["internal/server#ops"],
            "server-streams": ["internal/server#streams"],
            "cli": ["internal/cli"]
        },
        "scopes": {
            "internal/server": [
                "askops.go",
                "askwait.go",
                "attentionops.go",
                "cursorops.go",
                "eventops.go",
                "noteops.go",
                "nowops.go",
                "streamattention.go",
                "streamops.go"
            ],
            "internal/cli": [
                "askpoll.go",
                "asks.go",
                "attention.go",
                "notes.go",
                "now.go"
            ]
        },
        "parts": {
            "internal/server": {
                "ops": [
                    "askops.go",
                    "attentionops.go",
                    "cursorops.go",
                    "eventops.go",
                    "noteops.go",
                    "nowops.go"
                ],
                "streams": [
                    "askwait.go",
                    "streamattention.go",
                    "streamops.go"
                ]
            }
        },
        "fail_on_no_mutants": true
    },
    "stryker": {
        "enabled": true,
        "break": 80,
        "module_break": 80,
        "path": "web/src/lib"
    },
    "sbom_module": {
        "enabled": true
    },
    "sbom_frontend": {
        "enabled": true
    },
    "sbom_image": {
        "enabled": true
    },
    "openapi_lint": {
        "enabled": true
    },
    "openapi_drift": {
        "enabled": true
    }
}
